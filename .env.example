# Copie para ".env.local" para desenvolvimento (nunca commitado, ja esta no .gitignore).

# URL base da API. Padrao aponta para producao; use http://127.0.0.1:5000
# para desenvolver contra o backend rodando na sua maquina.
VITE_API_BASE_URL=https://bar-system-backend.onrender.com

# "true" para desenvolver com dados fake em memoria, sem precisar do
# backend/banco de dados real de pe. Desligue para testar contra a API real.
VITE_USE_MOCKS=false
